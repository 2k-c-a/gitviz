      }
    },
    "required": [
      "body"
    ],
    "title": "CreateCommentRequest",
    "type": "object"
  },
  "UpdateCommentRequest": {
    "additionalProperties": false,
    "properties": {
      "body": {
        "maxLength": 5000,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
        "title": "Body",
        "type": "string"
      }
    },
    "required": [
