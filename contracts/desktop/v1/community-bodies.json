  "VoiceSignalRequest": {
    "additionalProperties": false,
    "description": "WebRTC signaling relayed to one other seat: an SDP offer/answer, or one ICE candidate.",
    "properties": {
      "session_id": {
        "pattern": "^[A-Za-z0-9_-]{22}$",
        "title": "Session Id",
        "type": "string"
      },
      "to": {
        "pattern": "^[A-Za-z0-9_-]{22}$",
        "title": "To",
        "type": "string"
      },
      "kind": {
        "pattern": "^(offer|answer|ice)$",
        "title": "Kind",
        "type": "string"
      },
      "sdp": {
        "anyOf": [
          {
            "maxLength": 16000,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Sdp"
      },
      "candidate": {
        "anyOf": [
          {
            "maxLength": 1024,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Candidate"
      },
      "sdp_mid": {
        "anyOf": [
          {
            "maxLength": 64,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Sdp Mid"
      },
      "sdp_mline_index": {
        "anyOf": [
          {
            "maximum": 64,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Sdp Mline Index"
      }
    },
    "required": [
      "session_id",
      "to",
      "kind"
    ],
    "title": "VoiceSignalRequest",
    "type": "object"
  },
  "CreateCollabSessionRequest": {
    "additionalProperties": false,
    "description": "The host shares local files by the start file's name only; their content never goes to the server.\nfile_count (AD-34) is how many files the shared set holds, for the session list; absent means one file (AD-29).",
    "properties": {
      "file_name": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f/\\\\]*$",
        "title": "File Name",
        "type": "string"
      },
      "language": {
        "default": "plain",
        "pattern": "^(plain|javascript|typescript|jsx|tsx|python|json|markdown|css|html)$",
        "title": "Language",
        "type": "string"
      },
      "file_count": {
        "anyOf": [
          {
            "maximum": 60,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "File Count"
      }
    },
    "required": [
      "file_name"
    ],
    "title": "CreateCollabSessionRequest",
    "type": "object"
  },
  "CollabSeatRequest": {
    "additionalProperties": false,
    "properties": {
      "seat_id": {
        "pattern": "^[A-Za-z0-9_-]{22}$",
        "title": "Seat Id",
        "type": "string"
      }
    },
    "required": [
      "seat_id"
    ],
    "title": "CollabSeatRequest",
    "type": "object"
  },
  "CollabRelayRequest": {
    "additionalProperties": false,
    "description": "One Yjs message: a document update, a sync request/reply (state vector / diff) or a cursor (awareness) update.\nIn a file set (AD-34) `path` names the file (root-relative, absent for the set's file list), and `asset`/`asset-request`\ncarry a read-only image or font in pieces from the host to one seat.",
    "properties": {
      "seat_id": {
        "pattern": "^[A-Za-z0-9_-]{22}$",
        "title": "Seat Id",
        "type": "string"
      },
      "to": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z0-9_-]{22}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "To"
      },
      "kind": {
        "pattern": "^(update|sync-request|sync|awareness|asset|asset-request)$",
        "title": "Kind",
        "type": "string"
      },
      "data": {
        "maxLength": 200000,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9+/]+={0,2}$",
        "title": "Data",
        "type": "string"
      },
      "path": {
        "anyOf": [
          {
            "maxLength": 400,
            "minLength": 1,
            "pattern": "^[^/\\\\\\x00-\\x1f:*?\"<>|][^\\\\\\x00-\\x1f:*?\"<>|]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Path"
      }
    },
    "required": [
      "seat_id",
      "kind",
      "data"
    ],
    "title": "CollabRelayRequest",
    "type": "object"
  },
  "CreateEventRequest": {
    "$defs": {
      "EventAttachment": {
        "additionalProperties": false,
        "description": "A link to a file kept elsewhere (drive, GitHub, ...). The server stores no uploaded files.",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "title": "Name",
            "type": "string"
          },
          "url": {
            "maxLength": 500,
            "pattern": "^https://[^\\s\\x00-\\x1f\\x7f]{1,490}$",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "name",
          "url"
        ],
        "title": "EventAttachment",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "title": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f]*$",
        "title": "Title",
        "type": "string"
      },
      "description": {
        "default": "",
        "maxLength": 10000,
        "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
        "title": "Description",
        "type": "string"
      },
      "event_type": {
        "pattern": "^(meeting|team_meeting|tech_share|community_event|other|task|code_review|sprint|milestone|deploy|release)$",
        "title": "Event Type",
        "type": "string"
      },
      "status": {
        "default": "planned",
        "pattern": "^(planned|in_progress|done|cancelled)$",
        "title": "Status",
        "type": "string"
      },
      "starts_at": {
        "format": "date-time",
        "title": "Starts At",
        "type": "string"
      },
      "ends_at": {
        "format": "date-time",
        "title": "Ends At",
        "type": "string"
      },
      "all_day": {
        "default": false,
        "title": "All Day",
        "type": "boolean"
      },
      "assignee_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Assignee Id"
      },
      "participant_ids": {
        "items": {
          "format": "uuid",
          "type": "string"
        },
        "maxItems": 30,
        "title": "Participant Ids",
        "type": "array"
      },
      "location": {
        "anyOf": [
          {
            "maxLength": 200,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Location"
      },
      "meeting_url": {
        "anyOf": [
          {
            "maxLength": 500,
            "pattern": "^https://[^\\s\\x00-\\x1f\\x7f]{1,490}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Meeting Url"
      },
      "visibility": {
        "default": "community",
        "pattern": "^(community|participants)$",
        "title": "Visibility",
        "type": "string"
      },
      "reminder_minutes": {
        "anyOf": [
          {
            "maximum": 10080,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reminder Minutes"
      },
      "recurrence": {
        "default": "none",
        "pattern": "^(none|daily|weekly|monthly)$",
        "title": "Recurrence",
        "type": "string"
      },
      "recurrence_until": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Recurrence Until"
      },
      "sprint_id": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Sprint Id"
      },
      "milestone_id": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Milestone Id"
      },
      "post_id": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Post Id"
      },
      "issue_numbers": {
        "items": {
          "type": "integer"
        },
        "maxItems": 10,
        "title": "Issue Numbers",
        "type": "array"
      },
      "pull_numbers": {
        "items": {
          "type": "integer"
        },
        "maxItems": 10,
        "title": "Pull Numbers",
        "type": "array"
      },
      "release_tag": {
        "anyOf": [
          {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Release Tag"
      },
      "goal": {
        "anyOf": [
          {
            "maxLength": 2000,
            "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Goal"
      },
      "version": {
        "anyOf": [
          {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Version"
      },
      "environment": {
        "anyOf": [
          {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Environment"
      },
      "attachments": {
        "items": {
          "$ref": "#/$defs/EventAttachment"
        },
        "maxItems": 10,
        "title": "Attachments",
        "type": "array"
      }
    },
    "required": [
      "title",
      "event_type",
      "starts_at",
      "ends_at"
    ],
    "title": "CreateEventRequest",
    "type": "object"
  },
