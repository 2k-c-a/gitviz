        "title": "Title",
        "type": "string"
      },
      "body": {
        "maxLength": 20000,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
        "title": "Body",
        "type": "string"
      }
    },
    "required": [
