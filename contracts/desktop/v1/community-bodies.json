{
  "CreatePostRequest": {
    "additionalProperties": false,
    "properties": {
      "title": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f]*$",
        "title": "Title",
        "type": "string"
      },
      "body": {
        "maxLength": 20000,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
        "title": "Body",
        "type": "string"
      }
    },
    "required": [
      "title",
      "body"
    ],
    "title": "CreatePostRequest",
    "type": "object"
  },
  "UpdatePostRequest": {
    "additionalProperties": false,
