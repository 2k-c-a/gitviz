{
  "PrepareInputRequest": {
    "additionalProperties": false,
    "description": "POST /inputs. owner는 서버가 세션에서 정한다.",
    "properties": {
      "repository_id": {
        "exclusiveMinimum": 0,
        "title": "Repository Id",
        "type": "integer"
      },
      "pr_number": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Pr Number"
      },
      "commit_sha": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Commit Sha"
      },
      "expected_base_sha": {
        "title": "Expected Base Sha",
        "type": "string"
      },
      "expected_head_sha": {
        "title": "Expected Head Sha",
        "type": "string"
      },
      "selected_paths": {
        "items": {
          "type": "string"
        },
        "maxItems": 1000,
        "minItems": 1,
        "title": "Selected Paths",
        "type": "array"
      }
    },
    "required": [
      "repository_id",
      "expected_base_sha",
      "expected_head_sha",
      "selected_paths"
    ],
    "title": "PrepareInputRequest",
    "type": "object"
  },
  "CreateJobRequest": {
    "$defs": {
      "TransferConsent": {
        "additionalProperties": false,
        "description": "전송 동의: 사용자가 확인한 코드 범위(manifest_hash)와 제공자·모델. key는 앱이 헤더로 따로 보낸다(AD-33).",
        "properties": {
          "profile_fingerprint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Profile Fingerprint"
          },
          "input_id": {
            "format": "uuid",
            "title": "Input Id",
            "type": "string"
          },
          "manifest_hash": {
            "title": "Manifest Hash",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "profile_id": {
            "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
            "title": "Profile Id",
            "type": "string"
          },
          "policy_version": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Policy Version",
            "type": "string"
          }
        },
        "required": [
          "input_id",
          "manifest_hash",
          "provider",
          "profile_id",
          "policy_version"
        ],
        "title": "TransferConsent",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "POST /jobs: 동의한 전송 내용(코드 범위·제공자·모델)으로 설명·리뷰 생성을 접수한다. key는 X-GitViz-AI-Key 헤더.",
    "properties": {
      "kind": {
        "enum": [
          "summary",
          "review"
        ],
        "title": "Kind",
        "type": "string"
      },
      "consent": {
        "$ref": "#/$defs/TransferConsent"
      },
      "force_regenerate": {
        "default": false,
        "title": "Force Regenerate",
        "type": "boolean"
      },
      "history_snapshot_id": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "History Snapshot Id"
      }
    },
    "required": [
      "kind",
      "consent"
    ],
    "title": "CreateJobRequest",
    "type": "object"
  },
  "RetryJobRequest": {
    "$defs": {
      "TransferConsent": {
        "additionalProperties": false,
        "description": "전송 동의: 사용자가 확인한 코드 범위(manifest_hash)와 제공자·모델. key는 앱이 헤더로 따로 보낸다(AD-33).",
        "properties": {
          "profile_fingerprint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Profile Fingerprint"
          },
          "input_id": {
            "format": "uuid",
            "title": "Input Id",
            "type": "string"
          },
          "manifest_hash": {
            "title": "Manifest Hash",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "profile_id": {
            "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
            "title": "Profile Id",
            "type": "string"
          },
          "policy_version": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Policy Version",
            "type": "string"
          }
        },
        "required": [
          "input_id",
          "manifest_hash",
          "provider",
          "profile_id",
          "policy_version"
        ],
        "title": "TransferConsent",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "POST /jobs/{id}/retry: 실패·취소된 작업의 명시적 재생성. 비용·전송이 다시 생기므로 동의를 다시 받는다.",
    "properties": {
      "consent": {
        "$ref": "#/$defs/TransferConsent"
      }
    },
    "required": [
      "consent"
    ],
    "title": "RetryJobRequest",
    "type": "object"
  },
  "FeedbackRequest": {
    "$defs": {
      "Verdict": {
        "enum": [
          "valid",
          "false_positive",
          "uncertain"
        ],
        "title": "Verdict",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "verdict": {
        "$ref": "#/$defs/Verdict"
      },
      "note": {
        "anyOf": [
          {
            "maxLength": 2000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Note"
      },
      "expected_version": {
        "minimum": 0,
        "title": "Expected Version",
        "type": "integer"
      }
    },
    "required": [
      "verdict",
      "expected_version"
    ],
    "title": "FeedbackRequest",
    "type": "object"
  },
  "AttachHistoryRequest": {
    "additionalProperties": false,
    "properties": {
      "snapshot_id": {
        "minimum": 1,
        "title": "Snapshot Id",
        "type": "integer"
      },
      "as_of": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "As Of"
      }
    },
    "required": [
      "snapshot_id"
    ],
    "title": "AttachHistoryRequest",
    "type": "object"
  },
  "CreateInsightReportRequest": {
    "additionalProperties": false,
    "description": "POST /insights/reports. snapshot_id가 없으면 저장소의 최신 분석 결과를 쓴다.",
    "properties": {
      "repository_id": {
        "exclusiveMinimum": 0,
        "title": "Repository Id",
        "type": "integer"
      },
      "snapshot_id": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Snapshot Id"
      },
      "profile_id": {
        "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
        "title": "Profile Id",
        "type": "string"
      },
      "provider": {
        "pattern": "^[a-z][a-z0-9_-]{1,31}$",
        "title": "Provider",
        "type": "string"
      },
      "include_code": {
        "default": false,
        "title": "Include Code",
        "type": "boolean"
      }
    },
    "required": [
      "repository_id",
      "profile_id",
      "provider"
    ],
    "title": "CreateInsightReportRequest",
    "type": "object"
  },
  "CreateInsightConversationRequest": {
    "additionalProperties": false,
    "description": "POST /insights/conversations. 대화는 시작할 때의 분석 결과(스냅샷)와 모델에 묶인다.",
    "properties": {
      "repository_id": {
        "exclusiveMinimum": 0,
        "title": "Repository Id",
        "type": "integer"
      },
      "snapshot_id": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Snapshot Id"
      },
      "profile_id": {
        "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
        "title": "Profile Id",
        "type": "string"
      },
      "include_code": {
        "default": false,
        "title": "Include Code",
        "type": "boolean"
      }
    },
    "required": [
      "repository_id",
      "profile_id"
    ],
    "title": "CreateInsightConversationRequest",
    "type": "object"
  },
  "AskInsightQuestionRequest": {
    "additionalProperties": false,
    "description": "POST /insights/conversations/{id}/messages.",
    "properties": {
      "question": {
        "maxLength": 1000,
        "minLength": 1,
        "title": "Question",
        "type": "string"
      },
      "provider": {
        "pattern": "^[a-z][a-z0-9_-]{1,31}$",
        "title": "Provider",
        "type": "string"
      }
    },
    "required": [
      "question",
      "provider"
    ],
    "title": "AskInsightQuestionRequest",
    "type": "object"
  }
}