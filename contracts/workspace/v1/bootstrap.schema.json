{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "const": "bootstrap"
    },
    "protocolVersion": {
      "type": "integer",
      "const": 1
    },
    "keyVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "keyBase64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    }
  },
  "required": [
    "type",
    "protocolVersion",
    "keyVersion",
    "keyBase64"
  ],
  "additionalProperties": false
}
