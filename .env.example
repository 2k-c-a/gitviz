# 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 gitignore — 절대 커밋 금지).
#
# [공유] 표시된 값은 팀이 같은 값을 써야 한다. 한 명이 정해서 전파할 것.
# [개인] 표시된 값은 각자 발급/생성한다. 서로 달라도 된다.

# ── 데이터베이스 [공유] ───────────────────────────────────────────────────────
# 같은 DB를 두 엔진이 각각 쓴다. 접두사·포트가 다르니 둘 다 채울 것.
#   DATABASE_URL       → 동기(psycopg2). app/core/database.py, Celery 태스크
#                        Supabase Session 모드 풀러 (포트 5432)
#   DATABASE_URL_ASYNC → 비동기(asyncpg). app/database.py, auth 라우터
#                        ⚠️ 반드시 Transaction 모드 풀러 (포트 6543)
#     app/database.py가 NullPool + prepared statement 비활성화로 transaction 모드를
#     전제한다. 5432(session 모드)로 잘못 넣으면 동시 접속이 조금만 몰려도
#     Supabase에서 "max clients reached in session mode" 에러가 난다.
# DATABASE_URL_ASYNC 를 비우면 DATABASE_URL 을 쓰는데, 이때 접두사가
# postgresql+psycopg2:// 면 자동 변환이 안 걸려 asyncpg 엔진이 깨진다.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/postgres
DATABASE_URL_ASYNC=postgresql+asyncpg://<user>:<password>@<host>:6543/postgres

# ── GitHub OAuth App [공유] ──────────────────────────────────────────────────
# https://github.com/settings/developers 에서 OAuth App 생성 후 발급.
# 콜백 URL이 앱에 고정돼 있어 팀이 하나를 같이 쓴다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OAuth 토큰 AES-256 암호화 키 [공유 — 반드시 일치시킬 것] ──────────────────
# 반드시 64자리 hex (32바이트):
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# ⚠️ 이 키는 DB와 한 세트다. 이 키로 암호화한 OAuth 토큰이 공유 DB의
#    users.access_token_encrypted 에 저장되기 때문이다. 키가 다르면 복호화가
#    InvalidTag 로 깨지고 _resolve_github_token() 이 예외를 삼켜 조용히 공용
#    토큰으로 폴백한다 — 에러가 안 나서 알아차리기 어렵다.
#    DB를 갈아끼울 땐 이 키도 함께 가져올 것.
TOKEN_ENCRYPTION_KEY=

# ── GitHub API 토큰 [개인] ───────────────────────────────────────────────────
# 비로그인 분석과, 개인 OAuth 토큰이 없을 때의 폴백에 쓰인다.
#
# ⚠️ classic PAT 을 쓸 것 (repo 스코프):
#      https://github.com/settings/tokens/new?scopes=repo&description=GitViz
#    fine-grained PAT 은 소유자가 개인 계정이면 조직(2k-c-a) 레포에 404 가 나서
#    private repo 분석이 구현 오류처럼 보인다.
GITHUB_TOKEN=

# ── Celery 브로커 [개인 — 각자 로컬 Redis] ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── 세션 쿠키 서명 키 [개인] ─────────────────────────────────────────────────
# 서명·검증을 같은 서버가 하므로 로컬에선 각자 달라도 무방.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# ── 프론트엔드 URL (OAuth 콜백 리다이렉트 대상) [개인] ───────────────────────
# 백엔드가 프론트도 함께 서빙하므로 기본은 8000.
FRONTEND_URL=http://localhost:8000

# ── AI 기능 (기본 꺼짐) ──────────────────────────────────────────────────────
# AI_ENABLED=1이면 서버 시작 시 아래 보안 설정을 검증하고, 부족하면 시작하지 않는다.
AI_ENABLED=0
# 코드의 외부 AI 제공자 전송 허용. 0이면 입력 준비·조회만 가능하다.
AI_ALLOW_EXTERNAL_TRANSFER=0
# 허용하는 전송 정책 버전(쉼표 구분)
AI_POLICY_VERSIONS=code-transfer-v1
# 입력 코드 암호화 키: "버전:64자리hex" 쉼표 구분. 새 키 추가 후 AI_INPUT_KEY_VERSION을 바꾼다.
#   python -c "import secrets; print('v1:'+secrets.token_hex(32))"
AI_INPUT_ENCRYPTION_KEYS=
AI_INPUT_KEY_VERSION=v1
# 변경 요청(Origin)을 허용할 origin(쉼표 구분). 비우면 FRONTEND_URL
AI_ALLOWED_ORIGINS=
# 한도
AI_MAX_FILES=50
AI_MAX_INPUT_BYTES=2000000
AI_DAILY_JOB_LIMIT=30
# 횟수 상한을 없애려면 AI_DAILY_JOB_LIMIT=0 (API key 확인도 아래 별도 설정에 0 사용 가능)
# 작업 처리: 처리권(lease) 유효 시간, 최대 시도 횟수, 대기열 최대 대기 시간(초)
AI_LEASE_SECONDS=120
AI_MAX_ATTEMPTS=3
AI_QUEUE_DEADLINE_SECONDS=1800
AI_RETRY_DELAY_SECONDS=30
# 입력 준비: 준비된 입력으로 새 실행을 시작할 수 있는 시간(시), 원문 코드 보관 기간(일), 준비 제한(초)
AI_INPUT_VALID_HOURS=24
AI_INPUT_RETENTION_DAYS=7
# 생성 결과(요약·리뷰) 보관 기간(일)
AI_RESULT_RETENTION_DAYS=30
# dispatcher: outbox 발행 주기(초)와 유지관리(복구·기한 삭제) 주기(초). 기본 2 / 30
AI_DISPATCH_INTERVAL_SECONDS=2
AI_MAINTENANCE_INTERVAL_SECONDS=30
# 통합 시험 전용: 가짜 제공자 주소(로컬 주소만 허용). 운영에서는 반드시 비워 둔다.
# 사용자 API key는 이 값이 없으면 항상 공식 주소로만 간다(ANTHROPIC_BASE_URL 환경변수는 무시한다).
AI_TEST_PROVIDER_BASE_URL=
AI_PREPARE_TIME_LIMIT_SECONDS=120
# 사용자 API key(BYOK): 사용자가 자기 key를 등록한다. 서버 공용 제공자 key는 없다(ANTHROPIC_API_KEY 미사용).
# 사용자 key 암호화 키: 입력 코드 암호화 키와 별개이고 값이 달라야 한다. 형식은 AI_INPUT_ENCRYPTION_KEYS와 같다.
#   python -c "import secrets; print('c1:'+secrets.token_hex(32))"
AI_CREDENTIAL_ENCRYPTION_KEYS=
AI_CREDENTIAL_KEY_VERSION=c1
# 사용자가 고를 수 있는 모델 profile(쉼표 구분, 비우면 등록된 전체). profile은 app/services/ai/providers/registry.py의
# 버전 고정 값(모델·가격·한도·timeout)이다.
AI_ALLOWED_PROFILES=
# key 등록 때 제공자 확인(models 조회, 코드 미전송) 사용자당 시간당 한도
AI_CREDENTIAL_VERIFY_LIMIT_PER_HOUR=10
# 미리보기·기본 모델 profile(사용자가 아직 고르지 않았을 때)
AI_PROVIDER_PROFILE=claude-opus-5-5-v1

# 추가 BYOK profile: gpt-5.4-v1, gemini-3.5-flash-lite-v1
# 로컬: API·worker·Ollama를 같은 PC의 호스트 프로세스로 실행 (docs/AI_PROVIDER_SUPPORT.md)
# 로컬 모델은 직접 설치한다. 앱은 다운로드·cloud fallback을 하지 않는다.
AI_OLLAMA_ENABLED=0
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=qwen2.5-coder:7b
# /api/tags에 표시된 설치 모델의 전체 digest. 켜기 전에 반드시 설정한다.
AI_OLLAMA_MODEL_DIGEST=
# LM Studio / KoboldCpp: 인증 없는 로컬 서버, URL에는 /v1을 붙이지 않는다.
# MODEL은 해당 서버의 GET /v1/models 응답에 있는 정확한 id.
# 모델 ID만 확인하며 모델 파일 해시는 검증하지 않는다.
AI_LMSTUDIO_ENABLED=0
AI_LMSTUDIO_URL=http://127.0.0.1:1234
AI_LMSTUDIO_MODEL=
AI_LMSTUDIO_CONTEXT_WINDOW=8192
AI_LMSTUDIO_MAX_INPUT_TOKENS=4000
AI_LMSTUDIO_MAX_OUTPUT_TOKENS=4000
AI_LMSTUDIO_TIMEOUT_SECONDS=180
AI_KOBOLDCPP_ENABLED=0
AI_KOBOLDCPP_URL=http://127.0.0.1:5001
AI_KOBOLDCPP_MODEL=
AI_KOBOLDCPP_CONTEXT_WINDOW=8192
AI_KOBOLDCPP_MAX_INPUT_TOKENS=4000
AI_KOBOLDCPP_MAX_OUTPUT_TOKENS=4000
AI_KOBOLDCPP_TIMEOUT_SECONDS=180
# 월별 예산(통화 단위). 0보다 큰 사용자 예산은 사용자 key에도 적용한다.
# 서버 전체 합계 상한은 0보다 클 때만 적용한다(0=끔. 서버가 비용을 부담하지 않으면 보통 0).
AI_BUDGET_CURRENCY=USD
# AI_USER_MONTHLY_BUDGET=0이면 사용자 금액 상한 없음. 사용량·예약·정산 기록은 유지한다.
AI_USER_MONTHLY_BUDGET=20
AI_SERVER_MONTHLY_BUDGET=0
# HTTPS로 서비스할 때 1 (로컬이 아닌 origin에서 AI를 켜면 필수)
SESSION_COOKIE_SECURE=0
# 원격 DB의 CA 인증서 파일 경로. 지정하면 DB 연결에서 인증서·호스트명을 검증한다.
# AI를 켜고 원격 DB를 쓰면 필수.
DATABASE_SSL_CA=
