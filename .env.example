# ── 데이터베이스 (Supabase Supavisor 풀러) ──────────────────────────────────────
# DATABASE_URL: sync(psycopg2) 엔진용, Session 모드 풀러(포트 5432)
# DATABASE_URL_ASYNC: async(asyncpg) 엔진용, 반드시 Transaction 모드 풀러(포트 6543)
#   → app/database.py가 NullPool + prepared statement 비활성화로 transaction 모드를
#     전제하고 있음. 5432(session 모드)로 잘못 넣으면 동시 접속이 조금만 몰려도
#     Supabase 쪽 "max clients reached in session mode" 에러가 난다.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/postgres
DATABASE_URL_ASYNC=postgresql+asyncpg://<user>:<password>@<host>:6543/postgres

# ── 백그라운드 작업 큐 (Celery) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── GitHub OAuth App ─────────────────────────────────────────────────────────
# https://github.com/settings/developers 에서 OAuth App 생성 후 발급
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── 세션 쿠키 서명 키 ─────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))" 로 생성
SESSION_SECRET_KEY=

# ── OAuth 토큰 AES-256 암호화 키 ─────────────────────────────────────────────
# 반드시 64자리 hex 문자열 (32바이트)
# python -c "import secrets; print(secrets.token_hex(32))" 로 생성
TOKEN_ENCRYPTION_KEY=

# ── 프론트엔드 URL (콜백 리다이렉트 대상) ──────────────────────────────────────
FRONTEND_URL=http://localhost:3000
