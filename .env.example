# 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 gitignore — 절대 커밋 금지).
#
# [공유] 표시된 값은 팀이 같은 값을 써야 한다. 한 명이 정해서 전파할 것.
# [개인] 표시된 값은 각자 발급/생성한다. 서로 달라도 된다.

# ── 데이터베이스 [공유] ───────────────────────────────────────────────────────
# 같은 DB를 두 엔진이 각각 쓴다. 접두사가 다르니 둘 다 채울 것.
#   DATABASE_URL       → 동기(psycopg2). app/core/database.py, Celery 태스크
#   DATABASE_URL_ASYNC → 비동기(asyncpg). app/database.py, auth 라우터
# DATABASE_URL_ASYNC 를 비우면 DATABASE_URL 을 쓰는데, 이때 접두사가
# postgresql+psycopg2:// 면 자동 변환이 안 걸려 asyncpg 엔진이 깨진다.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/postgres
DATABASE_URL_ASYNC=postgresql+asyncpg://<user>:<password>@<host>:5432/postgres

# ── GitHub OAuth App [공유] ──────────────────────────────────────────────────
# https://github.com/settings/developers 에서 OAuth App 생성 후 발급.
# 콜백 URL이 앱에 고정돼 있어 팀이 하나를 같이 쓴다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OAuth 토큰 AES-256 암호화 키 [공유 — 반드시 일치시킬 것] ──────────────────
# 반드시 64자리 hex (32바이트):
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# ⚠️ 이 키는 DB와 한 세트다. 이 키로 암호화한 OAuth 토큰이 공유 DB의
#    users.access_token_encrypted 에 저장되기 때문이다. 키가 다르면 복호화가
#    InvalidTag 로 깨지고 _resolve_github_token() 이 예외를 삼켜 조용히 공용
#    토큰으로 폴백한다 — 에러가 안 나서 알아차리기 어렵다.
#    DB를 갈아끼울 땐 이 키도 함께 가져올 것.
TOKEN_ENCRYPTION_KEY=

# ── GitHub API 토큰 [개인] ───────────────────────────────────────────────────
# 비로그인 분석과, 개인 OAuth 토큰이 없을 때의 폴백에 쓰인다.
#
# ⚠️ classic PAT 을 쓸 것 (repo 스코프):
#      https://github.com/settings/tokens/new?scopes=repo&description=GitViz
#    fine-grained PAT 은 소유자가 개인 계정이면 조직(2k-c-a) 레포에 404 가 나서
#    private repo 분석이 구현 오류처럼 보인다.
GITHUB_TOKEN=

# ── Celery 브로커 [개인 — 각자 로컬 Redis] ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── 세션 쿠키 서명 키 [개인] ─────────────────────────────────────────────────
# 서명·검증을 같은 서버가 하므로 로컬에선 각자 달라도 무방.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# ── 프론트엔드 URL (OAuth 콜백 리다이렉트 대상) [개인] ───────────────────────
# 백엔드가 프론트도 함께 서빙하므로 기본은 8000.
FRONTEND_URL=http://localhost:8000
