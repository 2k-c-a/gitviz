{
  "name": "gitviz-workspace",
  "version": "0.7.0",
  "private": true,
  "description": "GitViz Windows workspace foundation",
  "author": "GitViz",
  "license": "UNLICENSED",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "config": {
    "forge": "./dist/forge.config.js"
  },
  "scripts": {
    "lint": "eslint src contracts tests scripts ui forge.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.preload.json",
    "typecheck:agent": "pyright --project ../pyright-workspace.json",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json && node scripts/build.mjs",
    "test": "node --test dist/tests/*.test.js",
    "test:foundation": "electron dist/tests/foundation.e2e.js",
    "start": "electron .",
    "package": "electron-forge package --platform=win32 --arch=x64",
    "make": "electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "es-module-lexer": "3.0.4",
    "parse5": "8.0.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "codemirror": "6.0.2",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "pyright": "1.1.414",
    "typescript-eslint": "8.72.0",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  }
}
